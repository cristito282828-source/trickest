# ════════════════════════════════════════════════════════════════
# REQUIRED — la app no arranca sin estas
# ════════════════════════════════════════════════════════════════

# ─── NextAuth ───
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                # generar con: openssl rand -base64 32

# ─── Supabase / Prisma ───
# Settings → Database → Connection string en supabase.com
DATABASE_URL=                   # Transaction pooler (port 6543, ?pgbouncer=true)
DIRECT_URL=                     # Session pooler (port 5432) — usado por prisma migrate
NEXT_PUBLIC_SUPABASE_URL=       # Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=  # Settings → API → anon/publishable key (client-side)
SUPABASE_SERVICE_ROLE_KEY=      # Settings → API → service_role/secret key (server-side, bypassea RLS)

# ─── Google OAuth ───
# console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ════════════════════════════════════════════════════════════════
# OPTIONAL — features que se degradan sin estas, no rompen
# ════════════════════════════════════════════════════════════════

# URL pública (Open Graph, social sharing). Defaultea a NEXTAUTH_URL si no está
NEXT_PUBLIC_APP_URL=

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=     # analytics.google.com
NEXT_PUBLIC_CLARITY_PROJECT_ID=    # clarity.microsoft.com

# Facebook Open Graph (fb:app_id en meta tags)
NEXT_PUBLIC_FACEBOOK_APP_ID=

# Cron jobs (vote system auto-approval)
CRON_SECRET=                       # openssl rand -base64 32

# Logging
DEBUG_AUTH=false                   # true solo en dev para debug de NextAuth
LOG_LEVEL=info                     # trace | debug | info | warn | error | silent

# ════════════════════════════════════════════════════════════════
# SCRIPTS ONLY — solo si vas a correr scripts puntuales
# ════════════════════════════════════════════════════════════════

# Para scripts/analyze-existing-submissions.js (análisis con GLM/Zhipu)
GLM_API_KEY=
